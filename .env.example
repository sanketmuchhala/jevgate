# System-1: Jev 1.14 via TypeSafe (https://console.typesafe.ai/keys).
# The TypeSafe SDK reads TYPESAFE_API_KEY and TYPESAFE_BASE_URL itself.
TYPESAFE_API_KEY=your-typesafe-api-key
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_S=1.5
JEV_MAX_RETRIES=1

# Or reach Jev through OpenRouter with the same SDK. "~typesafe/jev-latest" is an
# alias that moves between versions; check OpenRouter for a pinned 1.14 ID.
# Every decision records the versioned model that answered.
# TYPESAFE_API_KEY=your-openrouter-api-key
# TYPESAFE_BASE_URL=https://openrouter.ai/api
# JEV_MODEL=~typesafe/jev-latest

# System-2: the reviewer in system2/ (Vercel AI SDK -> OpenRouter).
# Leave SYSTEM2_URL unset to run System-1 only; open rules then go straight to a human.
SYSTEM2_URL=http://127.0.0.1:8787
SYSTEM2_TIMEOUT_S=20
OPENROUTER_API_KEY=your-openrouter-api-key
SYSTEM2_MODEL=anthropic/claude-sonnet-5.5
SYSTEM2_PORT=8787
SYSTEM2_TIMEOUT_MS=15000

# Optional: a different policy file.
# JEVGATE_POLICY=policies/default.json

# Case workbench storage (default: :memory:, lost when the app stops).
# JEVGATE_DB_PATH=data/jevgate.db
# Optional bearer token for cases, samples, reviewers, and audit endpoints.
# Reviewer names are request-supplied; this token does not verify individual identity.
# JEVGATE_API_TOKEN=replace-with-a-secret
